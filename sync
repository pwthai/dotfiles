#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$HOME/dotfiles"

_backup_if_plain() {
  local path="$1"
  if [ -e "$path" ] && [ ! -L "$path" ]; then
    local backup="${path}.bak.$(date +%s)"
    mv "$path" "$backup"
    echo "    Backed up $(basename "$path") -> $backup"
  fi
}

echo "==> Backing up any unmanaged conflicting targets"
_backup_if_plain "$HOME/.zshrc"
_backup_if_plain "$HOME/.tmux.conf"
_backup_if_plain "$HOME/.gitmux.conf"
_backup_if_plain "$HOME/.config/aerospace"
_backup_if_plain "$HOME/.config/ghostty"
_backup_if_plain "$HOME/.config/nvim"
_backup_if_plain "$HOME/.config/ohmyzsh"
_backup_if_plain "$HOME/.config/opencode"

echo "==> Restowing dotfiles"
mkdir -p "$HOME/.config"
stow --target="$HOME" --dir="$DOTFILES" --restow home

echo "==> Refreshing Oh My Zsh theme symlink"
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
mkdir -p "$ZSH_CUSTOM/themes"
ln -sf \
  "$DOTFILES/home/.config/ohmyzsh/themes/bubble-catppuccin.zsh-theme" \
  "$ZSH_CUSTOM/themes/bubble-catppuccin.zsh-theme"

echo "==> Done"
