#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
QUIET=false

usage() {
  echo "Usage: $(basename "$0") [--quiet]" >&2
}

case "${1:-}" in
  "")
    ;;
  --quiet)
    QUIET=true
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    echo "Error: unknown argument: $1" >&2
    usage
    exit 2
    ;;
esac

if [ "$#" -gt 1 ]; then
  echo "Error: too many arguments" >&2
  usage
  exit 2
fi

if [ ! -f "$DOTFILES/Brewfile" ]; then
  echo "Error: Brewfile not found next to install script: $DOTFILES/Brewfile" >&2
  exit 1
fi

step()  { echo ""; echo "==> $*"; }
info()  { echo "    $*"; }

# ─── 1. Xcode Command Line Tools ─────────────────────────────────────────────
step "Checking Xcode Command Line Tools"
if ! xcode-select -p >/dev/null 2>&1; then
  echo "Xcode CLT not found. Run: xcode-select --install, then re-run this script."
  exit 1
fi

# ─── 2. Homebrew ─────────────────────────────────────────────────────────────
step "Installing Homebrew (if missing)"
if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# ─── 3. Packages ─────────────────────────────────────────────────────────────
step "Installing packages from Brewfile"
if [ "$QUIET" = true ]; then
  brew bundle --file "$DOTFILES/Brewfile"
else
  brew bundle --verbose --file "$DOTFILES/Brewfile"
fi

# ─── 4. Oh My Zsh ────────────────────────────────────────────────────────────
step "Installing Oh My Zsh (if missing)"
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  RUNZSH=no CHSH=no sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
else
  info "Already installed"
fi

# ─── 5. NVM ──────────────────────────────────────────────────────────────────
step "Installing NVM (if missing)"
if [ ! -d "$HOME/.nvm" ]; then
  curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
else
  info "Already installed"
fi

export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck source=/dev/null
  . "$NVM_DIR/nvm.sh"
else
  echo "NVM installation is incomplete. Re-run this script."
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  step "Installing latest Node.js LTS"
  nvm install --lts
  nvm alias default 'lts/*'
fi

# ─── 6. Stow dotfiles ────────────────────────────────────────────────────────
step "Stowing dotfiles (target: $HOME)"

# Back up unmanaged targets that would block stow, including foreign symlinks.
_backup_if_unmanaged() {
  local path="$1"
  local resolved link parent backup base suffix=1 links=0

  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    return
  fi

  if [ -L "$path" ]; then
    resolved="$path"
    while [ -L "$resolved" ]; do
      links=$((links + 1))
      [ "$links" -le 40 ] || break
      link="$(readlink "$resolved")" || break
      case "$link" in
        /*) resolved="$link" ;;
        *)
          parent="$(cd -P "$(dirname "$resolved")" && pwd -P)" || break
          resolved="$parent/$link"
          ;;
      esac
    done

    if [ -e "$resolved" ]; then
      if [ -d "$resolved" ]; then
        resolved="$(cd -P "$resolved" && pwd -P)" || resolved=""
      else
        parent="$(cd -P "$(dirname "$resolved")" && pwd -P)" || parent=""
        resolved="$parent/$(basename "$resolved")"
      fi
      case "$resolved" in
        "$DOTFILES"|"$DOTFILES"/*) return ;;
      esac
    fi
  fi

  base="${path}.bak.$(date +%s)"
  backup="$base"
  while [ -e "$backup" ] || [ -L "$backup" ]; do
    backup="${base}.${suffix}"
    suffix=$((suffix + 1))
  done
  mv "$path" "$backup"
  info "Backed up unmanaged target $(basename "$path") -> $backup"
}

_backup_if_unmanaged "$HOME/.zshrc"
_backup_if_unmanaged "$HOME/.tmux.conf"
_backup_if_unmanaged "$HOME/.gitmux.conf"
_backup_if_unmanaged "$HOME/.gitmodules"
_backup_if_unmanaged "$HOME/.config/aerospace"
_backup_if_unmanaged "$HOME/.config/ghostty"
_backup_if_unmanaged "$HOME/.config/nvim"
_backup_if_unmanaged "$HOME/.config/ohmyzsh"
_backup_if_unmanaged "$HOME/.config/opencode"

mkdir -p "$HOME/.config"
stow --target="$HOME" --dir="$DOTFILES" --restow home

# ─── 7. Oh My Zsh custom theme ───────────────────────────────────────────────
step "Linking Oh My Zsh theme"
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
mkdir -p "$ZSH_CUSTOM/themes"
ln -sf \
  "$DOTFILES/home/.config/ohmyzsh/themes/bubble-catppuccin.zsh-theme" \
  "$ZSH_CUSTOM/themes/bubble-catppuccin.zsh-theme"
info "bubble-catppuccin.zsh-theme -> $ZSH_CUSTOM/themes/"

# ─── 8. TPM (Tmux Plugin Manager) ────────────────────────────────────────────
step "Installing TPM"
TPM="$HOME/.tmux/plugins/tpm"
if [ ! -d "$TPM" ]; then
  git clone https://github.com/tmux-plugins/tpm "$TPM"
else
  info "TPM present, pulling latest..."
  git -C "$TPM" pull --ff-only || true
fi

# ─── 9. Install tmux plugins headlessly ──────────────────────────────────────
step "Installing tmux plugins via TPM"
"$TPM/bin/install_plugins" || true

# ─── 10. macOS defaults ──────────────────────────────────────────────────────
step "Applying macOS defaults"
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock autohide-delay -float 0
defaults write com.apple.dock autohide-time-modifier -float 0
defaults write com.apple.dock mru-spaces -bool false
killall Dock >/dev/null 2>&1 || true

# ─── 11. Services ────────────────────────────────────────────────────────────
step "Starting borders"
if [ -x "$DOTFILES/scripts/start-borders.sh" ]; then
  "$DOTFILES/scripts/start-borders.sh" || true
fi

# ─────────────────────────────────────────────────────────────────────────────
step "Done"
echo ""
echo "NEXT STEPS:"
echo "  1) Open a new terminal (or run: exec zsh)"
echo "  2) In tmux, press prefix + I to install plugins for the first time"
echo "  3) System Settings -> Desktop & Dock:"
echo "       - Turn OFF 'Automatically rearrange Spaces based on most recent use'"
echo "  4) Create Spaces in Mission Control for your workspace keybinds (1..5, etc.)"
