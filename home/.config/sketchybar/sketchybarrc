#!/usr/bin/env bash

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# shellcheck source=colors.sh
source "$CONFIG_DIR/colors.sh"
# shellcheck source=icons.sh
source "$CONFIG_DIR/icons.sh"

FONT="Hack Nerd Font:Regular:12.0"
FONT_BOLD="Hack Nerd Font:Bold:12.0"
ICON_FONT="Hack Nerd Font Mono:Regular:14.0"
BAR_HEIGHT=27
MODULE_HEIGHT=27
PADDING=5
RADIUS=7
ITEM_EDGE_PADDING=9
ITEM_GAP=3
WORKSPACE_LABEL_PADDING=7
CONNECTIVITY_EDGE_PADDING=5

sketchybar --bar \
  position=top \
  height="$BAR_HEIGHT" \
  color="$BAR_BG" \
  border_width=0 \
  blur_radius=12 \
  margin=7 \
  padding_left="$PADDING" \
  padding_right="$PADDING" \
  sticky=on \
  topmost=on \
  y_offset=2 \
  corner_radius="$RADIUS" \
  shadow=off

sketchybar --default \
  icon.font="$ICON_FONT" \
  label.font="$FONT" \
  icon.color="$SUBTEXT" \
  label.color="$TEXT" \
  icon.padding_left="$ITEM_EDGE_PADDING" \
  icon.padding_right="$ITEM_GAP" \
  label.padding_left="$ITEM_GAP" \
  label.padding_right="$ITEM_EDGE_PADDING" \
  background.height=22 \
  background.corner_radius="$RADIUS" \
  background.border_width=0 \
  background.color=0x00000000

# Left: an Apple-style system menu and compact workspace module. Each pill owns
# its click target, so workspace switching works consistently on every display.
sketchybar --add item apple left \
  --set apple icon="$ICON_APPLE" icon.color="$LAVENDER" icon.font="$ICON_FONT" \
  icon.padding_left="$ITEM_EDGE_PADDING" icon.padding_right="$ITEM_EDGE_PADDING" label.drawing=off \
  script="$PLUGIN_DIR/apple_menu.sh host" \
  popup.align=left popup.height=29 popup.background.color="$MODULE_BG" \
  popup.background.border_color="$MODULE_BORDER" popup.background.border_width=1 \
  popup.background.corner_radius="$RADIUS" \
  --subscribe apple mouse.clicked mouse.exited.global

add_apple_menu_item() {
  local name="$1"
  local icon="$2"
  local label="$3"
  local accent="$4"
  local action="$5"

  sketchybar --add item "$name" popup.apple \
    --set "$name" icon="$icon" icon.color="$accent" icon.font="$ICON_FONT" \
      label="$label" label.color="$TEXT" label.font="$FONT" \
      icon.padding_left=10 icon.padding_right=5 label.padding_left=2 label.padding_right=14 \
      background.drawing=off click_script="$PLUGIN_DIR/apple_menu.sh $action"
}

add_apple_menu_item apple.about "$ICON_ABOUT" "About This Mac" "$BLUE" about
add_apple_menu_item apple.settings "$ICON_SETTINGS" "System Settings" "$LAVENDER" settings
add_apple_menu_item apple.force_quit "$ICON_FORCE_QUIT" "Force Quit Applications" "$RED" force_quit
add_apple_menu_item apple.lock "$ICON_LOCK" "Lock Screen" "$BLUE" lock
add_apple_menu_item apple.sleep "$ICON_SLEEP" "Sleep" "$LAVENDER" sleep
add_apple_menu_item apple.restart "$ICON_RESTART" "Restart…" "$YELLOW" restart
add_apple_menu_item apple.shutdown "$ICON_SHUTDOWN" "Shut Down…" "$RED" shutdown
add_apple_menu_item apple.logout "$ICON_LOGOUT" "Log Out…" "$PEACH" logout

sketchybar --add bracket apple_group apple \
  --set apple_group background.drawing=on background.color="$MODULE_BG" \
  background.border_color="$MODULE_BORDER" background.border_width=1 \
  background.corner_radius="$RADIUS" background.height="$MODULE_HEIGHT" background.padding_left=3 background.padding_right=3

add_spacer() {
  local name="$1"
  local position="$2"
  local width="$3"

  sketchybar --add item "$name" "$position" \
    --set "$name" drawing=on width="$width" icon.drawing=off label.drawing=off background.drawing=off
}

add_spacer apple_workspace_divider left 7

for workspace in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add item "workspace.$workspace" left \
    --set "workspace.$workspace" \
      label="$workspace" \
      label.font="$FONT_BOLD" \
      label.color="$PILL_IDLE_TEXT" \
      icon.drawing=off \
      background.drawing=on \
      background.color=0x00000000 \
      background.height=18 \
      background.corner_radius=5 \
      label.padding_left="$WORKSPACE_LABEL_PADDING" \
      label.padding_right="$WORKSPACE_LABEL_PADDING" \
      click_script="$PLUGIN_DIR/workspace.sh $workspace" \
      script="$PLUGIN_DIR/workspace.sh $workspace"
done

sketchybar --add bracket workspaces workspace.1 workspace.2 workspace.3 workspace.4 workspace.5 workspace.6 workspace.7 workspace.8 workspace.9 \
  --set workspaces background.drawing=on background.color="$MODULE_BG" \
  background.border_color="$MODULE_BORDER" background.border_width=1 \
  background.corner_radius="$RADIUS" background.height="$MODULE_HEIGHT" background.padding_left=3 background.padding_right=3

# Keep the front-app label left of a built-in camera notch; it remains a quiet
# centered-adjacent module on external displays without hardcoding monitor IDs.
sketchybar --add item front_app q \
  --set front_app icon.drawing=off label.font="$FONT" label.color="$SUBTEXT" \
  label.max_chars=30 label.padding_left="$ITEM_EDGE_PADDING" label.padding_right="$ITEM_EDGE_PADDING" script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched system_woke

sketchybar --add bracket app_group front_app \
  --set app_group background.drawing=on background.color="$MODULE_BG" \
  background.border_color="$MODULE_BORDER" background.border_width=1 \
  background.corner_radius="$RADIUS" background.height="$MODULE_HEIGHT" background.padding_left=3 background.padding_right=3

# Right: concise status modules; each reveals detail on click without widening the bar.
add_status_popup_row() {
  local host="$1"
  local icon="$2"
  local accent="$3"

  sketchybar --add item "$host.detail" "popup.$host" \
    --set "$host.detail" icon="$icon" icon.color="$accent" icon.font="$ICON_FONT" \
      label="Loading…" label.color="$TEXT" icon.padding_left=10 icon.padding_right=5 \
      label.padding_left=2 label.padding_right=14 background.drawing=off
}

add_status_settings_row() {
  local host="$1"
  local label="$2"
  local target="$3"

  sketchybar --add item "$host.settings" "popup.$host" \
    --set "$host.settings" icon="$ICON_SETTINGS" icon.color="$LAVENDER" icon.font="$ICON_FONT" \
      label="$label" label.color="$TEXT" icon.padding_left=10 icon.padding_right=5 \
      label.padding_left=2 label.padding_right=14 background.drawing=off \
      click_script="$PLUGIN_DIR/status_action.sh $host $target"
}

configure_status_host() {
  local host="$1"
  local icon="$2"
  local script="$3"
  local update_freq="$4"

  sketchybar --add item "$host" right \
    --set "$host" icon="$icon" script="$script" update_freq="$update_freq" \
      label.max_chars=10 popup.align=right popup.height=30 popup.background.color="$MODULE_BG" \
      popup.background.border_color="$MODULE_BORDER" popup.background.border_width=1 \
      popup.background.corner_radius="$RADIUS" \
    --subscribe "$host" mouse.clicked mouse.exited.global system_woke
}

sketchybar --add item clock right \
  --set clock icon="$ICON_CLOCK" label.font="$FONT_BOLD" script="$PLUGIN_DIR/clock.sh" update_freq=30 \
  --subscribe clock system_woke

sketchybar --add bracket clock_group clock \
  --set clock_group background.drawing=on background.color="$MODULE_BG" \
  background.border_color="$MODULE_BORDER" background.border_width=1 \
  background.corner_radius="$RADIUS" background.height="$MODULE_HEIGHT" background.padding_left=3 background.padding_right=3

add_spacer right_divider right 7

configure_connectivity_item() {
  local host="$1"
  local icon="$2"
  local update_freq="$3"
  local status_script="$4"

  sketchybar --add item "$host" right \
    --set "$host" icon="$icon" icon.font="$ICON_FONT" label.drawing=off update_freq="$update_freq" \
      icon.padding_left="$CONNECTIVITY_EDGE_PADDING" icon.padding_right="$CONNECTIVITY_EDGE_PADDING" \
      background.drawing=off script="$status_script" \
      click_script="$PLUGIN_DIR/control_center.sh" \
    --subscribe "$host" mouse.entered mouse.exited system_woke
}

# Compact custom controls retain real read-only Wi-Fi/Bluetooth state colors.
configure_connectivity_item wifi "$ICON_WIFI" 60 "$PLUGIN_DIR/wifi.sh"
configure_connectivity_item bluetooth "$ICON_BLUETOOTH" 60 "$PLUGIN_DIR/bluetooth.sh"
configure_connectivity_item focus "$ICON_FOCUS" 0 "$PLUGIN_DIR/connectivity.sh focus"

sketchybar --add bracket connectivity_group wifi bluetooth focus \
  --set connectivity_group background.drawing=on background.color="$MODULE_BG" \
  background.border_color="$MODULE_BORDER" background.border_width=1 \
  background.corner_radius="$RADIUS" background.height="$MODULE_HEIGHT" background.padding_left=3 background.padding_right=3

add_spacer connectivity_divider right 7

# Spotify keeps playback information available without opening or autoplaying it.
# SketchyBar observes this distributed notification when the installed version supports it;
# the three-second polling interval remains the guarded fallback.
sketchybar --add event spotify_playback_changed "com.spotify.client.PlaybackStateChanged"

sketchybar --add item spotify right \
  --set spotify icon="$ICON_SPOTIFY" icon.color="$SUBTEXT" label.drawing=off \
    label.font="$FONT" label.color="$TEXT" label.max_chars=24 \
    icon.padding_left="$ITEM_EDGE_PADDING" icon.padding_right="$ITEM_GAP" \
    label.padding_left="$ITEM_GAP" label.padding_right="$ITEM_EDGE_PADDING" \
    script="$PLUGIN_DIR/spotify.sh status" update_freq=3 popup.align=right popup.height=30 \
    popup.background.color="$MODULE_BG" popup.background.border_color="$MODULE_BORDER" \
    popup.background.border_width=1 popup.background.corner_radius="$RADIUS" \
  --subscribe spotify mouse.clicked mouse.exited.global system_woke spotify_playback_changed media_change media_play media_pause

sketchybar --add item spotify.detail popup.spotify \
  --set spotify.detail icon="$ICON_SPOTIFY" icon.color="$GREEN" icon.font="$ICON_FONT" \
    label="Spotify unavailable" label.color="$TEXT" icon.padding_left=10 icon.padding_right=5 \
    label.padding_left=2 label.padding_right=14 background.drawing=off

add_spotify_control() {
  local name="$1"
  local icon="$2"
  local label="$3"
  local action="$4"

  sketchybar --add item "spotify.$name" popup.spotify \
    --set "spotify.$name" icon="$icon" icon.color="$LAVENDER" icon.font="$ICON_FONT" \
      label="$label" label.color="$TEXT" icon.padding_left=10 icon.padding_right=5 \
      label.padding_left=2 label.padding_right=14 background.drawing=off \
      click_script="$PLUGIN_DIR/spotify.sh $action"
}

add_spotify_control previous "$ICON_PREVIOUS" "Previous" previous
add_spotify_control playpause "$ICON_PLAY" "Play" playpause
add_spotify_control next "$ICON_NEXT" "Next" next

sketchybar --add bracket spotify_group spotify \
  --set spotify_group background.drawing=on background.color="$MODULE_BG" \
  background.border_color="$MODULE_BORDER" background.border_width=1 \
  background.corner_radius="$RADIUS" background.height="$MODULE_HEIGHT" background.padding_left=3 background.padding_right=3

add_spacer spotify_divider right 7

configure_status_host volume "$ICON_VOLUME" "$PLUGIN_DIR/volume.sh" 0
sketchybar --subscribe volume volume_change
add_status_popup_row volume "$ICON_VOLUME" "$BLUE"
add_status_settings_row volume "Sound Settings" "x-apple.systempreferences:com.apple.Sound-Settings.extension"

configure_status_host battery "$ICON_BATTERY" "$PLUGIN_DIR/battery.sh" 120
sketchybar --subscribe battery power_source_change
add_status_popup_row battery "$ICON_BATTERY" "$YELLOW"
add_status_settings_row battery "Battery Settings" "x-apple.systempreferences:com.apple.Battery-Settings.extension"

sketchybar --add bracket power_group volume battery \
  --set power_group background.drawing=on background.color="$MODULE_BG" \
  background.border_color="$MODULE_BORDER" background.border_width=1 \
  background.corner_radius="$RADIUS" background.height="$MODULE_HEIGHT" background.padding_left=3 background.padding_right=3

sketchybar --add event aerospace_workspace_change \
  --subscribe workspace.1 aerospace_workspace_change system_woke \
  --subscribe workspace.2 aerospace_workspace_change system_woke \
  --subscribe workspace.3 aerospace_workspace_change system_woke \
  --subscribe workspace.4 aerospace_workspace_change system_woke \
  --subscribe workspace.5 aerospace_workspace_change system_woke \
  --subscribe workspace.6 aerospace_workspace_change system_woke \
  --subscribe workspace.7 aerospace_workspace_change system_woke \
  --subscribe workspace.8 aerospace_workspace_change system_woke \
  --subscribe workspace.9 aerospace_workspace_change system_woke

sketchybar --update
